# Copie para .env (que NÃO vai para o git):  cp .env.example .env
# Troque os valores. Senhas apenas para o ambiente local do lab.

# SQL Server exige senha forte: 8+ caracteres com maiúsculas, minúsculas, números e símbolos.
# Evite ";" e aspas (a senha entra na connection string).
MSSQL_SA_PASSWORD=TroqueEsta-Senha123

RABBITMQ_USER=lab
RABBITMQ_PASSWORD=troque-esta-senha

# --- Chaos da API (opcionais; desligados por padrão) ---
# Atraso artificial antes de cada query, em ms  (0)
# CHAOS_SQL_DELAY_MS=0
# Fração 0..1 de requisições que recebem 500, use ponto decimal  (0)
# CHAOS_ERROR_RATE=0

# --- Terminal.Worker (opcionais; valores padrão entre parênteses) ---
# Terminais consumidos: faixa e/ou lista, ex.: 1-50 ou 1,2,10-12  (1-50)
# TERMINAIS=1-50
# Mensagens sem ack por terminal  (10)
# PREFETCH=10
# Chaos: declara as filas mas não consome  (false)
# CHAOS_WORKER_PAUSED=false
